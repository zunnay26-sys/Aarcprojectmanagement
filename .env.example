# Start with: npm start (Node 22.13+). Copy to .env only if your host loads it.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Mandatory for first-time public installations (HOST=0.0.0.0):
# SETUP_SECRET=choose-a-long-random-secret
# Optional: explicit cloud AI analysis of OCR text only; leave unset for no AI API cost.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini
# Set NODE_ENV=production and use HTTPS reverse proxy when serving externally.
